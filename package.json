{
  "name": "obsidian-trip-mindmap",
  "version": "0.1.0",
  "private": true,
  "description": "Keyboard-driven mind maps (general + trip) for Obsidian",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/migrate.cjs --log-level=warning && node node_modules/.cache/migrate.cjs"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
